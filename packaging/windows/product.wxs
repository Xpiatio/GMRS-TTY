<?xml version="1.0" encoding="UTF-8"?>
<!--
    GMRS-TTY Windows installer — WiX v4
    Built by:  .\scripts\build-msi.ps1 [-Version X.Y.Z]

    The companion bundle-files.wxs (generated at build time by the script)
    provides the BundleComponents ComponentGroup with all bundled files.

    WiX v4 toolset required:
        dotnet tool install --global wix
        wix extension add WixToolset.UI.wixext
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="GMRS-TTY"
           Version="$(var.Version)"
           Manufacturer="Xpiatio"
           UpgradeCode="7F3E6B2A-C9D0-4E1F-8B5A-D234E567F890"
           Language="1033"
           InstallerVersion="500"
           Scope="perMachine">

    <!-- Replace older versions automatically; block downgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of GMRS-TTY is already installed." />

    <!-- Single-CAB, high-compression embed. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ------------------------------------------------------------------ -->
    <!-- Directory layout                                                     -->
    <!-- ------------------------------------------------------------------ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GMRS-TTY" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="GMRS-TTY" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ------------------------------------------------------------------ -->
    <!-- Shortcuts                                                            -->
    <!-- ------------------------------------------------------------------ -->

    <!-- Start Menu shortcut -->
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="*">
      <Shortcut Id="AppStartMenuShortcut"
                Name="GMRS-TTY"
                Description="GMRS/FRS speech-to-text and text-to-speech assistant"
                Target="[INSTALLFOLDER]python\pythonw.exe"
                Arguments='"[INSTALLFOLDER]main.py"'
                WorkingDirectory="INSTALLFOLDER" />
      <!-- Registry key makes this component idempotent (required for MSI). -->
      <RegistryValue Root="HKCU"
                     Key="Software\Xpiatio\GMRS-TTY"
                     Name="StartMenu"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
      <!-- Remove the empty Programs\GMRS-TTY folder on uninstall. -->
      <RemoveFolder Id="RemoveAppMenuFolder"
                    Directory="AppMenuFolder"
                    On="uninstall" />
    </Component>

    <!-- Desktop shortcut -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="AppDesktopShortcut"
                Name="GMRS-TTY"
                Description="GMRS/FRS speech-to-text and text-to-speech assistant"
                Target="[INSTALLFOLDER]python\pythonw.exe"
                Arguments='"[INSTALLFOLDER]main.py"'
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\Xpiatio\GMRS-TTY"
                     Name="Desktop"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- ------------------------------------------------------------------ -->
    <!-- Feature tree                                                         -->
    <!-- ------------------------------------------------------------------ -->
    <Feature Id="Complete" Level="1" Title="GMRS-TTY" Description="Full installation">
      <!-- BundleComponents is provided by the generated bundle-files.wxs -->
      <ComponentGroupRef Id="BundleComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- ------------------------------------------------------------------ -->
    <!-- Installer UI (WixUI_InstallDir — one install-path page)             -->
    <!-- ------------------------------------------------------------------ -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Point at the RTF licence bundled alongside this .wxs file.
         Path is relative to the .wxs file location at build time. -->
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\LICENSE.rtf" />

  </Package>
</Wix>
